# Copy this file to .env.local and fill in values from your Supabase project.
# Never commit .env.local — it is already ignored by .gitignore.

# Mode 1 (preferred): service role key. Keeps RLS bypassed on the server only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mode 2 (currently used): publishable key + JWKS URL.
# The app derives SUPABASE_URL from the JWKS URL origin and uses the anon role,
# so supabase/schema.sql includes public anon RLS policies.
NEXT_PUBLIC_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
